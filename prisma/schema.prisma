generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SeasonStatus {
  SETUP
  OPEN
  LOCKED
  COMPLETED
}

enum SubmissionMethod {
  SELF_SERVICE
  ADMIN_MANUAL
  IMPORTED
}

enum PaymentStatus {
  UNPAID
  PAID
  WAIVED
}

enum ScoringPeriodType {
  MONTHLY
  SEASON
}

enum ExportStatus {
  PENDING
  SENDING
  COMPLETED
  FAILED
}

enum DeliveryStatus {
  PENDING
  SENT
  DRY_RUN
  SKIPPED
  FAILED
}

/// A league runs one Season per MLB year. Everything a league's members see hangs
/// off its seasons; MLB data (players, game logs, projections) is shared across leagues.
model League {
  id                   String   @id @default(cuid())
  /// URL segment: /{slug}/standings. Lowercase letters, digits and dashes.
  slug                 String   @unique
  name                 String
  /// Clock the league's scoring periods roll over on.
  timeZone             String   @default("America/New_York")
  commissionerName     String?
  commissionerEmail    String?
  /// Email every team owner the standings workbook a couple of days after each month.
  monthlyExportEnabled Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  seasons Season[]
}

model Season {
  id                 String       @id @default(cuid())
  leagueId           String
  year               Int
  name               String
  entryDeadlineAt    DateTime
  regularSeasonStart DateTime
  regularSeasonEnd   DateTime
  entryStatus        SeasonStatus @default(SETUP)
  /// Free text for the export's first sheet (prize amounts, notes), one line per row.
  prizesText         String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  league              League                           @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  groups              Group[]
  scoringPeriods      ScoringPeriod[]
  entries             Entry[]
  seasonPlayerGroups  SeasonPlayerGroup[]
  statSnapshots       PlayerStatSnapshot[]
  playerPeriodStats   PlayerPeriodStat[]
  entryPeriodScores   EntryPeriodScore[]
  optimalLineups      OptimalLineup[]
  winOdds             EntryWinOdds[]
  standingSnapshots   EntryStandingSnapshot[]
  projectionSnapshots EntryOpeningProjectionSnapshot[]
  forecastSnapshots   PlayerForecastSnapshot[]
  exportRuns          ExportRun[]

  @@unique([leagueId, year])
  @@index([year])
}

model Group {
  id             String   @id @default(cuid())
  seasonId       String
  code           String
  name           String
  selectionCount Int
  sortOrder      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  season         Season                @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonPlayers  SeasonPlayerGroup[]
  entryPlayers   EntryPlayer[]
  playerStats    PlayerPeriodStat[]
  optimalPlayers OptimalLineupPlayer[]

  @@unique([seasonId, code])
  @@index([seasonId, sortOrder])
}

model Player {
  id               String   @id @default(cuid())
  providerPlayerId String?  @unique
  /// Not unique: two MLB players can share a name (Max Muncy). providerPlayerId is the identity.
  fullName         String
  mlbTeam          String?
  primaryPosition  String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  seasonGroups    SeasonPlayerGroup[]
  entryPlayers    EntryPlayer[]
  statSnapshots   PlayerStatSnapshot[]
  gameLogs        PlayerGameLog[]
  periodStats     PlayerPeriodStat[]
  historicalStats HistoricalPlayerStat[]
  projections     PlayerProjection[]
  optimalPlayers  OptimalLineupPlayer[]
  forecasts       PlayerForecastSnapshot[]

  @@index([fullName])
}

model SeasonPlayerGroup {
  id           String   @id @default(cuid())
  seasonId     String
  groupId      String
  playerId     String
  displayOrder Int?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([seasonId, playerId])
  @@unique([groupId, playerId])
  @@index([groupId, displayOrder])
}

/// A person. One owner can have several teams (entries) in a season, and every
/// team needs an owner email so the monthly workbook can reach them.
model Owner {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  phone       String?
  notes       String?
  /// The owner asked not to receive the monthly workbook.
  emailOptOut Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries    Entry[]
  deliveries ExportDelivery[]

  @@index([email])
}

model Entry {
  id               String           @id @default(cuid())
  seasonId         String
  ownerId          String
  /// What standings show ("Snoopy#2"). Unique within a season.
  teamName         String
  submissionMethod SubmissionMethod
  submittedAt      DateTime?
  isLocked         Boolean          @default(false)
  lockedAt         DateTime?
  paymentStatus    PaymentStatus    @default(UNPAID)
  paymentNote      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  season              Season                           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  owner               Owner                            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  players             EntryPlayer[]
  periodScores        EntryPeriodScore[]
  winOdds             EntryWinOdds[]
  standingSnapshots   EntryStandingSnapshot[]
  projectionSnapshots EntryOpeningProjectionSnapshot[]

  @@unique([seasonId, teamName])
  @@index([seasonId, ownerId])
  @@index([seasonId, submittedAt])
}

model EntryPlayer {
  id         String   @id @default(cuid())
  entryId    String
  groupId    String
  playerId   String
  slotNumber Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  entry  Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([entryId, groupId, slotNumber])
  @@unique([entryId, playerId])
}

model ScoringPeriod {
  id         String            @id @default(cuid())
  seasonId   String
  label      String
  startDate  DateTime
  endDate    DateTime
  sortOrder  Int
  periodType ScoringPeriodType
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  season              Season                           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  playerStats         PlayerPeriodStat[]
  entryScores         EntryPeriodScore[]
  optimalLineup       OptimalLineup?
  winOdds             EntryWinOdds[]
  standingSnapshots   EntryStandingSnapshot[]
  projectionSnapshots EntryOpeningProjectionSnapshot[]
  forecastSnapshots   PlayerForecastSnapshot[]
  exportRuns          ExportRun[]

  @@unique([seasonId, label])
  @@index([seasonId, sortOrder])
}

model HistoricalPlayerStat {
  id          String   @id @default(cuid())
  playerId    String
  seasonYear  Int
  gamesPlayed Int?
  atBats      Int?
  homeRuns    Int      @default(0)
  sluggingPct Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, seasonYear])
  @@index([seasonYear])
}

model PlayerProjection {
  id                   String    @id @default(cuid())
  playerId             String
  seasonYear           Int
  source               String
  projectedHomeRuns    Float?
  projectedAtBats      Float?
  projectedSluggingPct Float?
  importedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, seasonYear, source])
  @@index([seasonYear, source])
}

model PlayerStatSnapshot {
  id           String   @id @default(cuid())
  seasonId     String
  playerId     String
  snapshotDate DateTime
  teamCode     String?
  gamesPlayed  Int?
  atBats       Int?
  homeRuns     Int      @default(0)
  sluggingPct  Float?
  sourceName   String
  createdAt    DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([seasonId, playerId, snapshotDate])
  @@index([seasonId, snapshotDate])
}

/// One row per player per MLB regular-season game, straight from the StatsAPI game log.
/// This is the scoring source: a period's home runs are the sum over its game dates,
/// so a late-added player, a corrected MLB ID or a missed sync day is fixed by simply
/// re-importing the log. Keyed by year, not season, so leagues share it.
model PlayerGameLog {
  id         String   @id @default(cuid())
  playerId   String
  seasonYear Int
  gamePk     Int
  /// MLB's official game date (the date the host's spreadsheet uses).
  gameDate   DateTime @db.Date
  teamId     Int?
  homeRuns   Int      @default(0)
  atBats     Int      @default(0)
  totalBases Int      @default(0)
  importedAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, gamePk])
  @@index([seasonYear, gameDate])
  @@index([playerId, seasonYear])
}

/// What the forecast said for a player on a given day, kept so the season's
/// predictions can be scored against actuals afterwards.
model PlayerForecastSnapshot {
  id                        String   @id @default(cuid())
  seasonId                  String
  playerId                  String
  scoringPeriodId           String
  snapshotDate              DateTime @db.Date
  currentHomeRuns           Int
  expectedRemainingHomeRuns Float
  availability              String
  modelVersion              String
  createdAt                 DateTime @default(now())

  season        Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  player        Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  scoringPeriod ScoringPeriod @relation(fields: [scoringPeriodId], references: [id], onDelete: Cascade)

  @@unique([playerId, scoringPeriodId, snapshotDate])
  @@index([scoringPeriodId, snapshotDate])
}

/// One monthly workbook send for one season and period. Deliveries make it resumable:
/// a later run only sends to owners still PENDING or FAILED.
model ExportRun {
  id              String       @id @default(cuid())
  seasonId        String
  scoringPeriodId String
  status          ExportStatus @default(PENDING)
  dryRun          Boolean      @default(false)
  fileName        String
  error           String?
  startedAt       DateTime     @default(now())
  completedAt     DateTime?

  season        Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  scoringPeriod ScoringPeriod    @relation(fields: [scoringPeriodId], references: [id], onDelete: Cascade)
  deliveries    ExportDelivery[]

  @@unique([seasonId, scoringPeriodId, dryRun])
}

model ExportDelivery {
  id                String         @id @default(cuid())
  exportRunId       String
  ownerId           String
  email             String
  status            DeliveryStatus @default(PENDING)
  providerMessageId String?
  error             String?
  attempts          Int            @default(0)
  sentAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  exportRun ExportRun @relation(fields: [exportRunId], references: [id], onDelete: Cascade)
  owner     Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([exportRunId, ownerId])
  @@index([exportRunId, status])
}

model PlayerPeriodStat {
  id              String   @id @default(cuid())
  seasonId        String
  playerId        String
  scoringPeriodId String
  groupId         String
  homeRuns        Int      @default(0)
  atBats          Int?
  sluggingPct     Float?
  rankInGroup     Int?
  isTied          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  season        Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  player        Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  scoringPeriod ScoringPeriod @relation(fields: [scoringPeriodId], references: [id], onDelete: Cascade)
  group         Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([playerId, scoringPeriodId])
  @@index([scoringPeriodId, groupId, homeRuns])
}

model EntryPeriodScore {
  id              String   @id @default(cuid())
  seasonId        String
  entryId         String
  scoringPeriodId String
  homeRuns        Int      @default(0)
  rank            Int?
  isTied          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  season        Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  entry         Entry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  scoringPeriod ScoringPeriod @relation(fields: [scoringPeriodId], references: [id], onDelete: Cascade)

  @@unique([entryId, scoringPeriodId])
  @@index([scoringPeriodId, homeRuns])
}

model OptimalLineup {
  id              String   @id @default(cuid())
  seasonId        String
  scoringPeriodId String   @unique
  totalHomeRuns   Int      @default(0)
  computedAt      DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  season        Season                @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  scoringPeriod ScoringPeriod         @relation(fields: [scoringPeriodId], references: [id], onDelete: Cascade)
  players       OptimalLineupPlayer[]
}

model OptimalLineupPlayer {
  id              String   @id @default(cuid())
  optimalLineupId String
  groupId         String
  playerId        String
  slotNumber      Int
  homeRuns        Int      @default(0)
  rankInGroup     Int?
  createdAt       DateTime @default(now())

  optimalLineup OptimalLineup @relation(fields: [optimalLineupId], references: [id], onDelete: Cascade)
  group         Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  player        Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([optimalLineupId, groupId, slotNumber])
  @@unique([optimalLineupId, playerId])
}

model EntryWinOdds {
  id              String   @id @default(cuid())
  seasonId        String
  entryId         String
  scoringPeriodId String
  winProbability  Float
  top3Probability Float?
  expectedFinalHr Float?
  simulatedAt     DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  season        Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  entry         Entry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  scoringPeriod ScoringPeriod @relation(fields: [scoringPeriodId], references: [id], onDelete: Cascade)

  @@unique([entryId, scoringPeriodId])
  @@index([scoringPeriodId, winProbability])
}

model EntryStandingSnapshot {
  id              String   @id @default(cuid())
  seasonId        String
  entryId         String
  scoringPeriodId String
  snapshotDate    DateTime
  homeRuns        Int      @default(0)
  rank            Int
  isTied          Boolean  @default(false)
  createdAt       DateTime @default(now())

  season        Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  entry         Entry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  scoringPeriod ScoringPeriod @relation(fields: [scoringPeriodId], references: [id], onDelete: Cascade)

  @@unique([entryId, scoringPeriodId, snapshotDate])
  @@index([scoringPeriodId, snapshotDate])
}

model EntryOpeningProjectionSnapshot {
  id                String   @id @default(cuid())
  seasonId          String
  entryId           String
  scoringPeriodId   String
  snapshotDate      DateTime
  projectedHomeRuns Float
  projectionSource  String
  capturedAt        DateTime @default(now())

  season        Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  entry         Entry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  scoringPeriod ScoringPeriod @relation(fields: [scoringPeriodId], references: [id], onDelete: Cascade)

  @@unique([entryId, scoringPeriodId, snapshotDate])
  @@index([scoringPeriodId, snapshotDate])
}
